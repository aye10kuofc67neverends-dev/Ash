local isFlying = false
local bodyVelocity, bodyGyro, flyConnection

btnFly.MouseButton1Click:Connect(function()
	isFlying = not isFlying
	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid then return end

	if flyConnection then flyConnection:Disconnect() end
	if bodyVelocity then bodyVelocity:Destroy() end
	if bodyGyro then bodyGyro:Destroy() end

	if isFlying then
		humanoid.PlatformStand = true
		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bodyVelocity.Velocity = Vector3.new(0, 0, 0)
		bodyVelocity.Parent = rootPart

		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		bodyGyro.P = 20000
		bodyGyro.CFrame = rootPart.CFrame
		bodyGyro.Parent = rootPart

		flyConnection = RunService.RenderStepped:Connect(function()
			if not isFlying or not character.Parent or not rootPart.Parent then
				if flyConnection then flyConnection:Disconnect() end
				if bodyVelocity then bodyVelocity:Destroy() end
				if bodyGyro then bodyGyro:Destroy() end
				if humanoid then humanoid.PlatformStand = false end
				return
			end
			local speed = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 100 or 50
			local camCFrame = camera.CFrame
			local lookVector = camCFrame.LookVector
			local rightVector = camCFrame.RightVector
			local moveDirection = humanoid.MoveDirection
			local targetVelocity = Vector3.new(0, 0, 0)

			if moveDirection.Magnitude > 0 then
				targetVelocity = (lookVector * -moveDirection.Z + rightVector * moveDirection.X) * speed
			end

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then targetVelocity = targetVelocity + (lookVector * speed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then targetVelocity = targetVelocity - (lookVector * speed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then targetVelocity = targetVelocity - (rightVector * speed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then targetVelocity = targetVelocity + (rightVector * speed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then targetVelocity = targetVelocity + Vector3.new(0, speed, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.Q) then targetVelocity = targetVelocity - Vector3.new(0, speed, 0) end

			bodyVelocity.Velocity = targetVelocity
			bodyGyro.CFrame = camCFrame
		end)
	else
		humanoid.PlatformStand = false
	end
end)

