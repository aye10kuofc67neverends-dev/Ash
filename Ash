btnTornado.MouseButton1Click:Connect(function()
	pcall(function()
		local char = player.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then return end
		local root = char.HumanoidRootPart
		local oldBase = Workspace:FindFirstChild("LocalTornadoBase")
		if oldBase then oldBase:Destroy() end
		local oldFolder = Workspace:FindFirstChild("VisualDebris")
		if oldFolder then oldFolder:Destroy() end

		local base = Instance.new("Part")
		base.Name = "LocalTornadoBase"
		base.Position = root.Position + (root.CFrame.LookVector * 20)
		base.Anchored = true
		base.Transparency = 1
		base.Parent = Workspace

		local debrisFolder = Instance.new("Folder")
		debrisFolder.Name = "VisualDebris"
		debrisFolder.Parent = Workspace

		local parts = {}
		for i = 1, 25 do
			local p = Instance.new("Part")
			p.Size = Vector3.new(math.random(1,3), math.random(1,3), math.random(1,3))
			p.Color = Color3.fromRGB(120, 120, 120)
			p.Anchored = true
			p.CanCollide = false
			p.Parent = debrisFolder
			table.insert(parts, {Part = p, Height = (i/25)*60, Angle = (math.pi*2/25)*i, Speed = math.random(3,6)})
		end

		RunService.Heartbeat:Connect(function(dt)
			if not base.Parent then return end
			for _, data in ipairs(parts) do
				data.Angle = data.Angle + (data.Speed * dt)
				local rad = 5 + (30 - 5) * (data.Height / 60)
				data.Part.Position = base.Position + Vector3.new(math.cos(data.Angle)*rad, data.Height, math.sin(data.Angle)*rad)
			end
		end)
	end)
end)

