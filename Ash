ASH.btnServerHop.MouseButton1Click:Connect(function()
	pcall(function()
		local success, result = pcall(function()
			return ASH.HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/places/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
		end)
		if success and result and result.data then
			for _, server in ipairs(result.data) do
				if server.playing < server.maxPlayers and server.id ~= game.JobId then
					ASH.TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, ASH.player)
					break
				end
			end
		end
	end)
end)
